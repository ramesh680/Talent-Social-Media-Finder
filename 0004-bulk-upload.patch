+function setFile(f){
+  if (!f) return;
+  chosen = f;
+  $("#fname").textContent = f.name + " · " + Math.ceil(f.size/1024) + " KB";
+  $("#btn-bulk").disabled = false;
+}
+
+async function post(url, form){
+  const r = await fetch(url, {method:"POST", body:form});
+  return {status:r.status, data: await r.json()};
+}
+
+function countsHtml(counts){
+  const keys = Object.keys(counts||{});
+  if (!keys.length) return "";
+  return '<div class="counts">' + keys.map(k =>
+    `<span class="count ${esc(k)}"><b>${counts[k]}</b> ${esc(k)}</span>`
+  ).join("") + "</div>";
+}
+
+function mapHtml(m){
+  const keys = Object.keys(m||{});
+  if (!keys.length) return "";
+  return `<table><thead><tr><th>your header</th><th>read as</th></tr></thead><tbody>`
+    + keys.map(k => `<tr><td class="k">${esc(k)}</td><td class="v">${esc(m[k])}</td></tr>`).join("")
+    + `</tbody></table>`;
+}
+
+async function validateFile(){
+  if (!chosen) return;
+  const btn = $("#btn-validate"); btn.disabled = true;
+  out.innerHTML = "";
