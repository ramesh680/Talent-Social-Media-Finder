+    if (status >= 400){
+      out.innerHTML = `<section><div class="err"><strong>${esc(data.error)}</strong>
+        ${data.unmapped_headers && data.unmapped_headers.length
+          ? "<br>Unrecognised headers: " + esc(data.unmapped_headers.join(", ")) : ""}
+        </div></section>`;
+      return;
+    }
+    let h = `<section><div class="decision"><h2>File looks readable</h2>
+      <p>${data.valid_rows} rows with a name, ${data.without_role} of them with
+      no role hint.</p></div></section>`;
+    if (data.without_role > 0)
+      h += `<section><div class="warnbox">${data.without_role} row(s) have no
+        role. On a shared name those come back as <code>disambiguate</code>
+        rather than an answer — worth filling in first.</div></section>`;
+    if ((data.skipped_rows||[]).length)
+      h += `<section><div class="warnbox">${data.skipped_rows.length} row(s)
+        will be skipped (no name).</div></section>`;
+    h += `<section><h3>How your headers were read</h3>${mapHtml(data.header_map)}`;
+    if ((data.unmapped_headers||[]).length)
+      h += `<p class="hint">Ignored: ${esc(data.unmapped_headers.join(", "))}</p>`;
+    h += `</section>`;
+    if ((data.preview||[]).length){
+      h += `<section><h3>First rows</h3><div class="scroll"><table><thead><tr>
+        <th>row_id</th><th>name</th><th>role</th><th>year</th><th>country</th>
+        </tr></thead><tbody>` + data.preview.map(r =>
+        `<tr><td>${esc(r.row_id)}</td><td>${esc(r.name)}</td>
+             <td>${esc(r.role||"—")}</td><td>${esc(r.active_year||"—")}</td>
+             <td>${esc(r.country||"—")}</td></tr>`).join("")
+        + `</tbody></table></div></section>`;
+    }
+    out.innerHTML = h;
+  } finally { btn.disabled = false; }
+}
+
+let lastRows = null;
+
+async function runBulk(){
+  if (!chosen) return;
+  const btn = $("#btn-bulk"); btn.disabled = true;
+  const label = btn.textContent;
+  btn.innerHTML = '<span class="spin"></span>Resolving';
+  out.innerHTML = `<section><div class="decision"><h2>Working…</h2>
+    <p>Roughly 5–10 seconds per name in live mode. This page waits.</p>
+    </div></section>`;
+  try{
+    const fd = new FormData();
+    fd.append("file", chosen);
+    fd.append("max_rows", $("#maxrows").value || "25");
+    const {status, data} = await post("/api/bulk", fd);
+    if (status >= 400){
+      out.innerHTML = `<section><div class="err"><strong>${esc(data.error)}</strong></div></section>`;
+      return;
+    }
+    lastRows = data.rows || [];
+    let h = `<section><div class="decision"><h2>${data.processed} rows resolved</h2>
+      <p>${esc(data.mode)} mode · ${data.seconds}s${
+        data.stopped_because ? " · " + esc(data.stopped_because) : ""}</p>
+      </div>${countsHtml(data.decision_counts)}</section>`;
+
+    if ((data.unprocessed||[]).length)
+      h += `<section><div class="warnbox"><strong>${data.unprocessed.length}
+        row(s) not attempted.</strong> Re-upload a sheet containing just those
+        names — cached lookups make the second pass much faster.</div></section>`;
+    if ((data.skipped||[]).length)
+      h += `<section><div class="warnbox">${data.skipped.length} row(s) skipped
+        (no name).</div></section>`;
+
+    const cols = data.columns || [];
+    h += `<section><h3>Results</h3><div class="scroll"><table><thead><tr>`
+      + cols.map(c => `<th>${esc(c)}</th>`).join("")
+      + `</tr></thead><tbody>`
+      + lastRows.map(r => `<tr>` + cols.map(c => {
+          const v = r[c] ?? "";
+          if (c === "decision")
+            return `<td><span class="dec ${esc(v)}">${esc(v)}</span></td>`;
+          return `<td title="${esc(v)}">${esc(v)}</td>`;
+        }).join("") + `</tr>`).join("")
+      + `</tbody></table></div>
+        <div class="row2">
+          <button id="dl-xlsx">Download Excel</button>
+          <button id="dl-csv" style="background:#E6EAF1;color:var(--ink)">Download CSV</button>
+        </div></section>`;
+    out.innerHTML = h;
+    $("#dl-xlsx").addEventListener("click", () => download("xlsx"));
+    $("#dl-csv").addEventListener("click", () => download("csv"));
+  }catch(e){
+    out.innerHTML = `<section><div class="err"><strong>Upload failed.</strong><br>${esc(e.message)}</div></section>`;
+  }finally{
+    btn.disabled = false; btn.textContent = label;
+  }
+}
+
+async function download(fmt){
+  if (!lastRows) return;
+  const r = await fetch("/api/bulk/export", {
+    method:"POST", headers:{"Content-Type":"application/json"},
+    body: JSON.stringify({rows:lastRows, format:fmt})});
+  if (!r.ok) return;
+  const blob = await r.blob();
+  const a = document.createElement("a");
+  a.href = URL.createObjectURL(blob);
+  a.download = "talent-finder-results." + fmt;
+  document.body.appendChild(a); a.click(); a.remove();
+  URL.revokeObjectURL(a.href);
+}
+
+$("#btn-validate").addEventListener("click", validateFile);
+$("#btn-bulk").addEventListener("click", runBulk);
 </script>
 </body>
 </html>
