+"""Tests for bulk CSV/XLSX ingest. No network."""
+import csv
+import io
+import os
+import sys
+import time
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+from identityforge.bulk import (INPUT_COLUMNS, OUTPUT_COLUMNS, canon_country,
+                                canon_header, canon_role, flatten_result,
+                                parse_csv, parse_upload, parse_xlsx, run_batch,
+                                to_csv, to_xlsx)
+from identityforge.template import build_template_csv, build_template_xlsx
+
+PASS = FAIL = 0
+
+
+def check(label, got, want):
+    global PASS, FAIL
+    if got == want:
+        PASS += 1
+        print(f"  ok   {label}")
+    else:
+        FAIL += 1
+        print(f"  FAIL {label}\n         got  {got!r}\n         want {want!r}")
+
+
+print("\n=== 1. Header aliasing (real sheets never use your names) ===")
+for raw, want in [
+    ("name", "name"), ("Name", "name"), ("Talent Name", "name"),
+    ("full_name", "name"), ("TITLE", "name"), ("Artist Name", "name"),
+    ("role", "role"), ("Title Category", "role"), ("title_category", "role"),
+    ("Occupation", "role"), ("active_year", "active_year"),
+    ("Campaign Year", "active_year"), ("Market", "country"),
+    ("Nationality", "country"), ("Show", "context"), ("Brand Set", "client"),
+    ("Sr. No.", "row_id"), ("row_id", "row_id"), ("TICKET-ID", "row_id"),
+    ("Remarks", "notes"),
+]:
+    check(f"{raw!r}", canon_header(raw), want)
+check("unknown header ignored", canon_header("Follower Count 2024"), None)
+check("blank header", canon_header("   "), None)
+check("None header", canon_header(None), None)
+
+print("\n=== 2. Value normalisation ===")
+check("singer -> musician", canon_role("Singer")[0], "musician")
+check("footballer -> athlete", canon_role("footballer")[0], "athlete")
+check("actress -> actor", canon_role("Actress")[0], "actor")
+check("influencer -> creator", canon_role("Influencer")[0], "creator")
+check("exact bucket kept", canon_role("director")[0], "director")
+check("blank role ok", canon_role("")[0], "")
+role, warn = canon_role("astronaut")
+check("unknown role dropped not guessed", role, "")
+check("unknown role warns", "unrecognised" in warn, True)
+
+check("India -> Q668", canon_country("India"), "Q668")
+check("USA -> Q30", canon_country("usa"), "Q30")
+check("UK -> Q145", canon_country("United Kingdom"), "Q145")
+check("raw qid passes through", canon_country("Q884"), "Q884")
+check("unknown country passes through", canon_country("Atlantis"), "Atlantis")
+check("blank country", canon_country(""), "")
+
+print("\n=== 3. CSV parsing ===")
+rows = [["Sr. No.", "Talent Name", "Title Category", "Campaign Year", "Market"],
+        ["T-1", "A.R. Rahman", "singer", "2010", "India"],
+        ["T-2", "", "actor", "2020", "India"],
+        ["T-3", "Christopher Nolan", "director", "not a year", "UK"]]
+buf = io.StringIO()
+csv.writer(buf).writerows(rows)
+p = parse_csv(buf.getvalue().encode())
+check("no errors", p.errors, [])
+check("headers mapped", p.header_map["Talent Name"], "name")
+check("valid rows", len(p.valid_rows), 2)
+check("empty name skipped", len(p.invalid_rows), 1)
+check("row_id preserved", p.valid_rows[0].row_id, "T-1")
+check("role normalised", p.valid_rows[0].role, "musician")
+check("country to qid", p.valid_rows[0].country, "Q668")
+check("bad year ignored with warning", p.valid_rows[1].active_year, None)
+check("year warning recorded",
+      any("active_year" in w for w in p.valid_rows[1].warnings), True)
+
+print("\n  -- semicolon delimiter (common in EU exports) --")
+p2 = parse_csv(b"name;role\nA.R. Rahman;singer\n")
+check("semicolons sniffed", len(p2.valid_rows), 1)
+check("value parsed", p2.valid_rows[0].role, "musician")
+
+print("\n  -- missing name column is a hard error, with the headers echoed --")
+p3 = parse_csv(b"foo,bar\n1,2\n")
+check("error raised", len(p3.errors), 1)
+check("error names the fix", "name" in p3.errors[0], True)
+check("error lists headers seen", "foo" in p3.errors[0], True)
+
+print("\n  -- encoding tolerance --")
+p4 = parse_csv("name\nBeyoncé\n".encode("utf-8-sig"))
+check("utf-8 BOM stripped", p4.valid_rows[0].name, "Beyoncé")
+p5 = parse_csv("name\nBeyoncé\n".encode("latin-1"))
+check("latin-1 fallback", len(p5.valid_rows), 1)
+check("blank file errors", len(parse_csv(b"").errors), 1)
+
+print("\n=== 4. XLSX parsing and template round-trip ===")
+tpl = build_template_xlsx()
+px = parse_xlsx(tpl)
+check("our own template parses", px.errors, [])
+check("Input sheet chosen", len(px.valid_rows), 6)
+check("example row intact", px.valid_rows[0].name, "A. R. Rahman")
+check("non-latin row survives",
+      any(not r.name.isascii() for r in px.valid_rows), True)
+check("template csv parses", parse_csv(build_template_csv()).errors, [])
+check("sniffs xlsx without extension", parse_upload("blob", tpl).errors, [])
+check("routes csv by extension",
+      parse_upload("x.csv", b"name\nFoo\n").valid_rows[0].name, "Foo")
+
+print("\n  -- a legend block above the header must not break it --")
+from openpyxl import Workbook
+wb = Workbook()
+ws = wb.active
+ws.append(["Talent list for Q3"])
+ws.append(["prepared by data ops"])
+ws.append([])
+ws.append(["name", "role"])
+ws.append(["A.R. Rahman", "singer"])
+b = io.BytesIO()
+wb.save(b)
+p6 = parse_xlsx(b.getvalue())
+check("header found below a title block", p6.errors, [])
+check("row read correctly", p6.valid_rows[0].name, "A.R. Rahman")
+
+print("\n=== 5. Batching under a budget ===")
+p7 = parse_csv(b"name\nA\nB\nC\nD\nE\n")
+check("five rows parsed", len(p7.valid_rows), 5)
+
+calls = []
+
+
+def fake_resolve(pr):
+    calls.append(pr.name)
+    return {"decision": "resolved", "entity_id": "Q1", "label": pr.name,
+            "roles": ["musician"], "coverage": 0.5,
+            "handles": {"instagram": [{"handle": pr.name.lower(),
+                                       "confidence": 0.9}]},
+            "external_ids": {"spotify_artist": "abc"}}
+
+
+b1 = run_batch(p7, fake_resolve, max_rows=3)
+check("max_rows respected", b1.processed, 3)
+check("overflow reported as unprocessed", len(b1.unprocessed), 2)
+check("unprocessed says why", "max_rows" in b1.unprocessed[0]["why"], True)
+
+
+def slow_resolve(pr):
+    time.sleep(0.12)
+    return {"decision": "resolved", "entity_id": "Q1", "label": pr.name,
+            "roles": [], "coverage": 0, "handles": {}, "external_ids": {}}
+
+
+b2 = run_batch(p7, slow_resolve, time_budget_seconds=0.2)
+check("budget stops the run early", b2.processed < 5, True)
+check("at least one row always attempted", b2.processed >= 1, True)
+check("stop reason recorded", "time budget" in b2.stopped_because, True)
+check("remainder returned", len(b2.unprocessed) > 0, True)
+
+
+def boom(pr):
+    raise RuntimeError("upstream exploded")
+
+
+b3 = run_batch(parse_csv(b"name\nA\nB\n"), boom)
+check("one bad row does not kill the batch", b3.processed, 2)
+check("error captured per row", b3.rows[0]["decision"], "error")
+check("error message kept", "exploded" in b3.rows[0]["notes"], True)
+
+print("\n=== 6. Output flattening ===")
+p8 = parse_csv(b"row_id,name\nR9,Michael Jackson\n")
+pr = p8.valid_rows[0]
+
+row = flatten_result(pr, {
+    "decision": "resolved", "entity_id": "Q2831", "label": "Michael Jackson",
+    "roles": ["musician"], "coverage": 0.75,
+    "handles": {"instagram": [{"handle": "mj", "confidence": 0.9}],
+                "wikipedia": [{"handle": "Michael Jackson", "lang": "en",
+                               "confidence": 0.8},
+                              {"handle": "\u30de\u30a4\u30b1\u30eb", "lang": "ja",
+                               "confidence": 0.8}]},
+    "needs_review": [{"platform": "youtube", "handle": "UCx",
+                      "confidence": 0.55}],
+    "external_ids": {"spotify_artist": "3fM", "imdb": "nm1"}})
+check("row_id echoed", row["row_id"], "R9")
+check("all output columns present", set(row.keys()), set(OUTPUT_COLUMNS))
+check("instagram handle placed", row["instagram"], "mj")
+check("multi-language wikipedia joined",
+      row["wikipedia"], "Michael Jackson (en) | \u30de\u30a4\u30b1\u30eb (ja)")
+check("review column carries confidence",
+      row["needs_review"], "youtube:UCx@0.55")
+check("spoke ids sorted and joined",
+      row["spoke_ids"], "imdb=nm1 | spotify_artist=3fM")
+
+row2 = flatten_result(pr, {"decision": "disambiguate",
+                           "reason": "top two too close",
+                           "cards": [{"entity_id": "Q1", "roles": ["musician"],
+                                      "description": "singer"},
+                                     {"entity_id": "Q2", "roles": ["athlete"],
+                                      "description": "footballer"}]})
+check("disambiguate lists alternates", "Q1:musician:singer" in row2["alternates"], True)
+check("disambiguate keeps reason", "too close" in row2["notes"], True)
+check("no handle invented on disambiguate", row2["instagram"], "")
+
+row3 = flatten_result(pr, {"decision": "unverified_only",
+                           "proposals": [{"platform": "instagram",
+                                          "handle": "guess1"}]})
+check("unverified proposals listed", "instagram:guess1" in row3["alternates"], True)
+check("unverified row is labelled UNVERIFIED", "UNVERIFIED" in row3["notes"], True)
+check("no handle column filled when unverified", row3["instagram"], "")
+
+row4 = flatten_result(pr, {"decision": "not_found"})
+check("not_found explained", "identity graph" in row4["notes"], True)
+
+print("\n=== 7. Writers ===")
+data = to_csv([row, row2])
+check("csv has BOM for Excel", data[:3], b"\xef\xbb\xbf")
