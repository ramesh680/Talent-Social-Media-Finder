+/* ---------------- bulk upload ---------------- */
+let chosen = null;
+
+function showTab(which){
+  const single = which === "single";
+  $("#tab-single").setAttribute("aria-selected", single);
+  $("#tab-bulk").setAttribute("aria-selected", !single);
+  $("#pane-single").hidden = !single;
+  $("#pane-bulk").hidden = single;
+  out.innerHTML = "";
+}
+$("#tab-single").addEventListener("click", () => showTab("single"));
+$("#tab-bulk").addEventListener("click", () => showTab("bulk"));
+
+const drop = $("#drop"), fileInput = $("#file");
+$("#pick").addEventListener("click", () => fileInput.click());
+fileInput.addEventListener("change", () => setFile(fileInput.files[0]));
+["dragenter","dragover"].forEach(ev => drop.addEventListener(ev, e => {
+  e.preventDefault(); drop.classList.add("over"); }));
+["dragleave","drop"].forEach(ev => drop.addEventListener(ev, e => {
+  e.preventDefault(); drop.classList.remove("over"); }));
