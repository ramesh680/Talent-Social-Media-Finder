+    data = f.read()
+    if not data:
+        return jsonify({"error": "The uploaded file is empty."}), 400
+
+    parsed = bulk_mod.parse_upload(f.filename or "", data)
+    if parsed.errors:
+        return jsonify({"error": parsed.errors[0],
