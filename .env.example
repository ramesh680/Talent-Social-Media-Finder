# Copy to .env for local use. NEVER commit a filled-in copy.
# On Render these go in Environment (mark every one as a secret).

IF_LIVE=0                         # 1 enables all outbound requests
TMDB_API_KEY=                     # v3 key - actors/directors, external_ids in one call
TMDB_READ_ACCESS_TOKEN=           # v4 bearer, optional
OMDB_API_KEY=                     # TITLE lookups only, contributes no handles
SERPAPI_API_KEY=                  # DISCOVERY only - proposals are never auto-accepted
SERPAPI_ENGINE=google
WIKIMEDIA_CONTACT=                # required by Wikimedia UA policy or they 403
REQUEST_TIMEOUT_SECONDS=12
CACHE_TTL_SECONDS=900
IF_DB_PATH=/tmp/identityforge.db
IF_CACHE_PATH=/tmp/http_cache.db
